# Salin file ini menjadi .env lalu isi API key Anda.
# API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_api_key_di_sini

# Model utama dan cadangan (cek yang tersedia dengan: python cek_model.py)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_CADANGAN=gemini-3.8-flash

# Opsional: kosongkan agar model embedding dipilih otomatis
# GEMINI_EMBED_MODEL=gemini-embedding-001
